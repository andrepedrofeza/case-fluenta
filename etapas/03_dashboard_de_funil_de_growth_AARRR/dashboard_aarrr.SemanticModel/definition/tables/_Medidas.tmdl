		displayFolder: 5. Período anterior
		lineageTag: bff130d8-db39-4f7f-952c-453fd925b9bb

	measure '% Cadastros Indicação PA' =
			CALCULATE (
			    [% Cadastros Indicação],
			    REMOVEFILTERS ( dim_data ),
			    DATESBETWEEN ( dim_data[data], [PA Início], [PA Fim] )
			)
		formatString: 0.0%
		displayFolder: 5. Período anterior
		lineageTag: 591b2526-f95c-4031-adba-872d4ca4d254

	measure 'Δ Alunos Ativados' = DIVIDE ( [Alunos Ativados (est.)] - [Alunos Ativados PA], [Alunos Ativados PA] )
		formatString: ▲ 0.0%;▼ 0.0%;0.0%
		displayFolder: 6. Variação
		lineageTag: 6278b843-8512-42e8-872d-d96c060e18a9

	measure 'Δ Cadastros' = DIVIDE ( [Cadastros] - [Cadastros PA], [Cadastros PA] )
		formatString: ▲ 0.0%;▼ 0.0%;0.0%
		displayFolder: 6. Variação
		lineageTag: 2a73c3ee-d7ff-4411-a5cd-393d0238a4dc

	measure 'Δ Taxa Ativação (p.p.)' =
			IF (
			    NOT ISBLANK ( [Taxa Ativação] ) && NOT ISBLANK ( [Taxa Ativação PA] ),
			    ( [Taxa Ativação] - [Taxa Ativação PA] ) * 100
			)
		formatString: ▲ 0.0 \p\.\p\.;▼ 0.0 \p\.\p\.;0.0 \p\.\p\.
		displayFolder: 6. Variação
		lineageTag: c8eda776-bbc9-474d-809b-3f10c9d76813

	measure 'Δ Retenção D30 (p.p.)' =
			IF (
			    NOT ISBLANK ( [Retenção D30] ) && NOT ISBLANK ( [Retenção D30 PA] ),
			    ( [Retenção D30] - [Retenção D30 PA] ) * 100
			)
		formatString: ▲ 0.0 \p\.\p\.;▼ 0.0 \p\.\p\.;0.0 \p\.\p\.
		displayFolder: 6. Variação
		lineageTag: e0708b3b-6a04-4c38-aa00-0558daf77495

	measure 'Δ Receita Líquida' = DIVIDE ( [Receita Líquida] - [Receita Líquida PA], [Receita Líquida PA] )
		formatString: ▲ 0.0%;▼ 0.0%;0.0%
		displayFolder: 6. Variação
		lineageTag: 346fc2cd-628e-40b6-9f78-22ce81e40357

	measure 'Δ Vendas Válidas' = DIVIDE ( [Vendas Válidas] - [Vendas Válidas PA], [Vendas Válidas PA] )
		formatString: ▲ 0.0%;▼ 0.0%;0.0%
		displayFolder: 6. Variação
		lineageTag: be2203bb-aa16-468d-84d9-deeec5970521

	measure 'Δ Ticket Médio' = DIVIDE ( [Ticket Médio] - [Ticket Médio PA], [Ticket Médio PA] )
		formatString: ▲ 0.0%;▼ 0.0%;0.0%
		displayFolder: 6. Variação
		lineageTag: 8c9ac838-191a-476c-8388-5143180edc97

	measure 'Δ % Receita Assinatura (p.p.)' =
			IF (
			    NOT ISBLANK ( [% Receita Assinatura] ) && NOT ISBLANK ( [% Receita Assinatura PA] ),
			    ( [% Receita Assinatura] - [% Receita Assinatura PA] ) * 100
			)
		formatString: ▲ 0.0 \p\.\p\.;▼ 0.0 \p\.\p\.;0.0 \p\.\p\.
		displayFolder: 6. Variação
		lineageTag: ef76d918-ad75-48d6-bb67-5cfc7484b5c1

	measure 'Δ % Cadastros Indicação (p.p.)' =
			IF (
			    NOT ISBLANK ( [% Cadastros Indicação] ) && NOT ISBLANK ( [% Cadastros Indicação PA] ),
			    ( [% Cadastros Indicação] - [% Cadastros Indicação PA] ) * 100
			)
		formatString: ▲ 0.0 \p\.\p\.;▼ 0.0 \p\.\p\.;0.0 \p\.\p\.
		displayFolder: 6. Variação
		lineageTag: 49db67fc-fb72-429a-8591-8cda4aada062

	measure 'Resposta Saudável' =
			VAR _rec = DIVIDE ( [Receita Líquida] - [Receita Líquida PA], [Receita Líquida PA] )
			VAR _cad = [Δ Cadastros]
			VAR _ret = [Retenção D30]
			RETURN
			    -- Critério de "saudável" a combinar com o Growth: cadastros crescendo e retenção D30 >= 40%
			    IF ( _cad > 0 && _ret >= 0.4, "Sim: ", "Ainda não: " )
			        & "receita " & FORMAT ( _rec, "+0%;-0%" )
			        & ", cadastros " & FORMAT ( _cad, "+0%;-0%" )
			        & " e só " & FORMAT ( _ret, "0%" ) & " dos alunos seguem estudando após 30 dias."
		displayFolder: 8. Textos
		lineageTag: 791a2ed3-a378-4b3e-a5c1-a90d27cf6d4a

	measure 'Texto Comparação' =
			VAR _ini = MIN ( dim_data[data] )
			VAR _dias = INT ( MAX ( dim_data[data] ) - _ini ) + 1
			VAR _ultimaVenda = CALCULATE ( MAX ( fact_vendas[data_id] ), REMOVEFILTERS () )
			VAR _ultimoCadastro = CALCULATE ( MAX ( fact_onboarding_aluno[data_id] ), REMOVEFILTERS () )
			-- Última coorte com ativação/retenção medidas (fora disso, as taxas não existem)
			VAR _ultimaCoorte =
			    CALCULATE ( MAX ( fact_onboarding_aluno[data_id] ), REMOVEFILTERS (), NOT ISBLANK ( fact_onboarding_aluno[ativado] ) )
			RETURN
			    "Comparação: " & FORMAT ( _ini - _dias, "dd/mm/yy" ) & "–" & FORMAT ( _ini - 1, "dd/mm/yy" )
			        & " (mesma duração) · Vendas até " & FORMAT ( LOOKUPVALUE ( dim_data[data], dim_data[data_id], _ultimaVenda ), "dd/mm" )
			        & " · cadastros até " & FORMAT ( LOOKUPVALUE ( dim_data[data], dim_data[data_id], _ultimoCadastro ), "dd/mm" )
			        & " · ativação e retenção até " & FORMAT ( LOOKUPVALUE ( dim_data[data], dim_data[data_id], _ultimaCoorte ), "dd/mm" )
		displayFolder: 8. Textos
		lineageTag: 2f021922-7976-4af0-89a6-90b1cd65a47c

	measure 'Título Aquisição' =
			VAR _top = TOPN ( 1, ALLSELECTED ( dim_canal[grupo_canal] ), [Cadastros] )
			RETURN
			    "Cadastros " & FORMAT ( [Δ Cadastros], "+0%;-0%" ) & " vs período anterior; "
			        & CONCATENATEX ( _top, dim_canal[grupo_canal], ", " ) & " traz "
			        & FORMAT ( DIVIDE ( CALCULATE ( [Cadastros], _top ), [Cadastros] ), "0%" )
		displayFolder: 8. Textos
		lineageTag: b21ce692-221a-4b5c-bca5-4b90df2c1623

	measure 'Título Ativação' =
			"Histórico mensal: ativação de " & FORMAT ( [Taxa Ativação], "0%" ) & "; "
			    & FORMAT ( 1 - [Taxa Ativação], "0%" ) & " dos novos alunos não chegam a 3 lições na 1ª semana"
		displayFolder: 8. Textos
		lineageTag: 58f2f97b-6b2a-4e29-a17f-38a7560807ba

	measure 'Título Receita' =
			VAR _meses = ADDCOLUMNS ( VALUES ( dim_data[inicio_mes] ), "@r", [Receita Líquida] )
			VAR _pico = TOPN ( 1, _meses, [@r] )
			RETURN
			    "Histórico mensal: receita média de " & FORMAT ( AVERAGEX ( _meses, [@r] ) / 1000, "#,0", "pt-BR" ) & " mil/mês; pico em "
			        & FORMAT ( MAXX ( _pico, dim_data[inicio_mes] ), "mmm/yy", "pt-BR" )
		displayFolder: 8. Textos
		lineageTag: 422d7d51-e07d-4948-88fc-87beafc6a383

	measure 'Título Recomendação' = "Histórico mensal: indicação traz " & FORMAT ( [% Cadastros Indicação], "0.0%", "pt-BR" ) & " dos cadastros (proxy de recomendação)"
		displayFolder: 8. Textos
		lineageTag: 2e42c321-e335-49e2-91fd-03405b987043

	measure 'Título Evidência' =
			VAR _ativ = CALCULATE ( [Retenção D30], fact_onboarding_aluno[ativado] = 1 )
			VAR _nao = CALCULATE ( [Retenção D30], fact_onboarding_aluno[ativado] = 0 )
			RETURN
			    "Onde agir: quem ativa na 1ª semana retém " & FORMAT ( DIVIDE ( _ativ, _nao ), "0.0", "pt-BR" ) & "× mais em D30"
		displayFolder: 8. Textos
		lineageTag: 2f0c235e-8b2b-43b1-9450-4c4c8c09b9a2

	measure 'Título Retenção' =
			-- Segue o Período: a faixa entre canais é calculada no recorte, em vez de afirmar que nenhum canal destoa
			VAR _canais =
			    FILTER (
			        ADDCOLUMNS ( VALUES ( dim_canal[grupo_canal] ), "@r", [Retenção D30] ),
			        NOT ISBLANK ( [@r] )
			    )
			RETURN
			    "Só " & FORMAT ( [Retenção D30], "0%" ) & " seguem estudando em D30; por canal, de "
			        & FORMAT ( MINX ( _canais, [@r] ), "0%" ) & " a " & FORMAT ( MAXX ( _canais, [@r] ), "0%" )
		displayFolder: 8. Textos
		lineageTag: 77e207e1-5df9-47d6-8b11-7a1e9ab36c36

	measure 'Cor Δ Alunos Ativados' =
			SWITCH (
			    TRUE (),
			    ISBLANK ( [Δ Alunos Ativados] ), "#999999",
			    [Δ Alunos Ativados] < 0, "#D55E00",
			    "#0072B2"
			)
		displayFolder: 7. Cores
		lineageTag: 92b1f64d-4ded-493e-8901-325fbd4397b8

	measure 'Cor Δ Cadastros' =
