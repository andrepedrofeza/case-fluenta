table _Medidas
	lineageTag: c8fa74c4-e6cb-44ec-a2fd-65cb5b03a3c8

	measure Cadastros = COUNTROWS ( fact_onboarding_aluno )
		formatString: #,0
		displayFolder: 1. Aquisição
		lineageTag: c230836d-9cf1-408e-841a-5af340772659

	measure 'Usuários instrumentados' = COUNT ( fact_onboarding_aluno[ativado] )
		formatString: #,0
		displayFolder: 2. Ativação e Retenção
		lineageTag: 58e614ce-a3c5-435b-a673-471bb781ae12

	measure 'Taxa Ativação' = AVERAGE ( fact_onboarding_aluno[ativado] )
		formatString: 0.0%
		displayFolder: 2. Ativação e Retenção
		lineageTag: ddbf6804-1ac8-458f-95b4-4810773f2e02

	measure 'Retenção D30' = AVERAGE ( fact_onboarding_aluno[retido_d30] )
		formatString: 0.0%
		displayFolder: 2. Ativação e Retenção
		lineageTag: 19b5bc89-6a5d-4ad6-9779-2889af09baeb

	measure 'Alunos Ativados (est.)' = [Cadastros] * [Taxa Ativação]
		formatString: #,0
		displayFolder: 0. North Star
		lineageTag: 76f9e200-0755-4f30-84eb-0c145ffdf115

	measure 'Receita Líquida' =
			CALCULATE (
			    SUM ( fact_vendas[valor_liquido] ),
			    fact_vendas[status_pagamento] = "aprovado",
			    fact_vendas[venda_gratuita] = FALSE ()
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 3. Receita
		lineageTag: 14fffc55-12b8-4f54-b158-8832deb39124

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Vendas Válidas' =
			CALCULATE (
			    COUNTROWS ( fact_vendas ),
			    fact_vendas[status_pagamento] = "aprovado",
			    fact_vendas[venda_gratuita] = FALSE ()
			)
		formatString: #,0
		displayFolder: 3. Receita
		lineageTag: 14ced41e-ba81-4c96-a61a-fee8490bd2c6

	measure 'Ticket Médio' = DIVIDE ( [Receita Líquida], [Vendas Válidas] )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 3. Receita
		lineageTag: 0ad0cfdc-df49-4cfd-82c6-9fe58e640071

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '% Receita Assinatura' = DIVIDE ( CALCULATE ( [Receita Líquida], dim_produto[tipo_produto] = "Assinatura" ), [Receita Líquida] )
		formatString: 0.0%
		displayFolder: 3. Receita
		lineageTag: a751fbca-7c06-4e20-b5c4-b0ffa889acf1

	measure '% Cadastros Indicação' =
			DIVIDE (
			    CALCULATE ( [Cadastros], REMOVEFILTERS ( dim_canal ), dim_canal[grupo_canal] = "Indicação" ),
			    CALCULATE ( [Cadastros], REMOVEFILTERS ( dim_canal ) )
			)
		formatString: 0.0%
		displayFolder: 4. Recomendação
		lineageTag: 5059d6a7-4bbb-4fd3-ad6f-6070c8c6b2e2

	measure 'Cor Amostra' = IF ( [Usuários Instrumentados] < 100, "#9ECAE1", "#0072B2" )
		displayFolder: 7. Cores
		lineageTag: dd622fcb-a654-4724-854c-999dbd5a06cc

	measure 'Alunos Ativados (amostra)' = CALCULATE ( COUNTROWS ( fact_onboarding_aluno ), fact_onboarding_aluno[ativado] = 1 )
		formatString: #,0
		displayFolder: 0. North Star
		lineageTag: 3d0375a0-05ba-4f31-868f-769bc8b00260

	measure 'PA Início' =
			VAR _ini = MIN ( dim_data[data] )
			VAR _dias = INT ( MAX ( dim_data[data] ) - _ini ) + 1
			RETURN _ini - _dias
		formatString: dd/mm/yyyy
		displayFolder: 5. Período anterior
		lineageTag: 79c2ac0f-6f13-4731-9f87-28e09a7e4cbc

	measure 'PA Fim' = MIN ( dim_data[data] ) - 1
		formatString: dd/mm/yyyy
		displayFolder: 5. Período anterior
		lineageTag: 52bf8be3-df39-4f3c-b3ab-1aa4375c2c13

	measure 'Alunos Ativados PA' =
			CALCULATE (
			    [Alunos Ativados (est.)],
			    REMOVEFILTERS ( dim_data ),
			    DATESBETWEEN ( dim_data[data], [PA Início], [PA Fim] )
			)
		formatString: #,0
		displayFolder: 5. Período anterior
		lineageTag: 0d92d740-a8d8-478c-b943-f6719b654ad1

	measure 'Cadastros PA' =
			CALCULATE (
			    [Cadastros],
			    REMOVEFILTERS ( dim_data ),
			    DATESBETWEEN ( dim_data[data], [PA Início], [PA Fim] )
			)
		formatString: #,0
		displayFolder: 5. Período anterior
		lineageTag: 4977b5c2-10cd-48f7-8d81-e41b6e5ddbf5

	measure 'Taxa Ativação PA' =
			CALCULATE (
			    [Taxa Ativação],
			    REMOVEFILTERS ( dim_data ),
			    DATESBETWEEN ( dim_data[data], [PA Início], [PA Fim] )
			)
		formatString: 0.0%
		displayFolder: 5. Período anterior
		lineageTag: 71701fe9-6dfd-4d69-b658-91f6826e1b2a

	measure 'Retenção D30 PA' =
			CALCULATE (
