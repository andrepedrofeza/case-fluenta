		formatString: 0.0%
		displayFolder: 5. Período anterior
		lineageTag: 81bb70ba-3cb1-487f-854f-b37775b92526

	measure 'Receita Líquida PA' =
			CALCULATE (
			    [Receita Líquida],
			    REMOVEFILTERS ( dim_data ),
			    DATESBETWEEN ( dim_data[data], [PA Início], [PA Fim] )
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 5. Período anterior
		lineageTag: 5adc2653-1f98-4094-b444-cb2e3edc5c09

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Vendas Válidas PA' =
			CALCULATE (
