			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 5. Período anterior
		lineageTag: 40e26416-61ad-424e-85b6-ab5195d5510c

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '% Receita Assinatura PA' =
			CALCULATE (
			    [% Receita Assinatura],
			    REMOVEFILTERS ( dim_data ),
